{
  "name": "project-documentation-standards",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable project documentation and quality checks",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs --run",
    "check:static": "node scripts/check-project.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:quality": "node scripts/check-quality.mjs --run",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/check-project.test.mjs tests/check-parts.test.mjs tests/function-length.test.mjs"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
